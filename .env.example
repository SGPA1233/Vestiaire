# Copiez ce fichier vers .env et complétez les valeurs avant de lancer
# l'application en local (npm run dev). En production sur Vercel, ces
# variables se configurent dans le tableau de bord Vercel (Settings →
# Environment Variables), pas dans un fichier .env commité.

# --- Base de données (Supabase) --------------------------------------------------
# Dans Supabase : Project Settings → Database → Connection string.
# DATABASE_URL = connexion "Transaction pooler" (port 6543, via PgBouncer)
# DIRECT_URL   = connexion "Direct connection" (port 5432, utilisée uniquement
#                pour les migrations, qui ne fonctionnent pas via le pooler)
DATABASE_URL="postgresql://postgres.xxxxx:MOT_DE_PASSE@aws-0-xx-xxxx-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxxx:MOT_DE_PASSE@aws-0-xx-xxxx-1.pooler.supabase.com:5432/postgres"

# --- Authentification -----------------------------------------------------------
# Générez une valeur aléatoire, par ex. avec : openssl rand -base64 32
AUTH_SECRET="a-remplacer-par-une-chaine-aleatoire-longue"
# Sur Vercel, inutile de la définir : l'URL est détectée automatiquement.
# NEXTAUTH_URL="https://dotation.vercel.app"
# URL publique utilisée pour les liens d'accès générés par un administrateur.
APP_URL="http://localhost:3000"

# --- Général ---------------------------------------------------------------------
APP_NAME="Dotation Vêtements"

# --- Fonctionnalité facultative ---------------------------------------------------
# Signature tactile sur tablette après une perception (désactivée par défaut).
ENABLE_SIGNATURE=false

# --- Uniquement pour `npm run db:seed` (données de démonstration) ----------------
SEED_ADMIN_EMAIL=admin@entreprise.ch
SEED_ADMIN_PASSWORD="A_REMPLACER_PAR_UN_SECRET_DE_12_CARACTERES_MINIMUM"
