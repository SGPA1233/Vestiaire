# Exemple de configuration Nginx (reverse proxy vers le conteneur Docker de
# l'application, qui écoute sur 127.0.0.1:3000).
#
# À copier vers /etc/nginx/sites-available/dotation.entreprise.ch puis :
#   ln -s /etc/nginx/sites-available/dotation.entreprise.ch /etc/nginx/sites-enabled/
#   nginx -t && systemctl reload nginx
#
# Les certificats HTTPS peuvent être obtenus avec certbot :
#   certbot --nginx -d dotation.entreprise.ch

server {
    listen 80;
    server_name dotation.entreprise.ch;

    # Redirection HTTPS obligatoire (certbot ajoutera automatiquement le
    # bloc HTTPS 443 avec les certificats lors de la première exécution).
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    server_name dotation.entreprise.ch;

    # ssl_certificate     /etc/letsencrypt/live/dotation.entreprise.ch/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/dotation.entreprise.ch/privkey.pem;

    client_max_body_size 10m;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
